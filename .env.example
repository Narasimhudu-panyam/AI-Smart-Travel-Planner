# Frontend Environment Variables (Vercel / Local)
# For local development: leave empty (Vite /api proxy handles it) or set to http://localhost:8000
# For Vercel production: set to your deployed FastAPI backend URL, e.g. https://your-fastapi-backend.com
VITE_API_URL=http://localhost:8000

# Client-side Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend Environment Variables (Production FastAPI Hosting / Local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/?appName=<app-name>
MONGODB_DATABASE=smart_travel_planner

# Production Vercel domain(s) for CORS allowlist (comma-separated if multiple)
FRONTEND_URL=https://your-frontend-domain.vercel.app
FRONTEND_ORIGIN=https://your-frontend-domain.vercel.app

# AI Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key

# External Service Keys (Server-side only, never exposed to client)
GOOGLE_MAPS_API_KEY=your_google_maps_platform_key
OPENWEATHER_API_KEY=your_openweather_api_key

# Optional Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
